# ==========================================
# LowkeySMS Frontend - Environment Variables
# ==========================================

# Backend API URL (use '/api' for Vite dev proxy, or full backend URL 'https://api.yourdomain.com/api')
VITE_API_URL=/api

# Cloudflare Turnstile CAPTCHA (Production site key from Cloudflare Dashboard)
# Leaving this empty disables the Turnstile widget during local development
VITE_TURNSTILE_SITE_KEY=

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Leaving this empty renders a clean unavailable fallback button without GSI console errors
VITE_GOOGLE_CLIENT_ID=
